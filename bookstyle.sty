%----------------------------------------------------------------------------------------
%   PAGE STYLES
%----------------------------------------------------------------------------------------

\renewcommand{\chaptermark}[1]{\markboth{\sffamily\normalsize\bfseries\chaptername\ \thechapter.\ #1}{}}
\renewcommand{\sectionmark}[1]{\markright{\sffamily\normalsize\thesection\hspace{5pt}#1}{}}

\setlength{\headheight}{15pt}

\newcommand{\bookstylefancysetup}{%
  \fancyhf{}
  \fancyhead[LE,RO]{\sffamily\normalsize\thepage}
  \fancyhead[LO]{\rightmark}
  \fancyhead[RE]{\leftmark}
  \renewcommand{\headrulewidth}{0.5pt}
  \renewcommand{\footrulewidth}{0pt}
}

\newcommand{\bookstylesimplesetup}{%
  \fancyhf{}
  \fancyfoot[C]{\sffamily\normalsize\thepage}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}

\fancypagestyle{fancy}{\bookstylefancysetup}
\fancypagestyle{simple}{\bookstylesimplesetup}

\newcommand{\bookstyleplaintosimple}{%
  \fancypagestyle{plain}{\bookstylesimplesetup}%
}

\newcommand{\bookstyleplaintofancy}{%
  \fancypagestyle{plain}{\bookstylefancysetup}%
}

\bookstyleplaintosimple

\makeatletter
\AtBeginDocument{%
  \apptocmd{\frontmatter}{\pagestyle{simple}\bookstyleplaintosimple}{}{%
    \PackageWarning{bookstyle}{Could not patch \string\frontmatter}%
  }%
  \apptocmd{\mainmatter}{\pagestyle{fancy}\bookstyleplaintofancy}{}{%
    \PackageWarning{bookstyle}{Could not patch \string\mainmatter}%
  }%
}

\renewcommand{\cleardoublepage}{\clearpage\ifodd\c@page\else\hbox{}\vspace*{\fill}\thispagestyle{empty}\newpage\fi}
\makeatother

