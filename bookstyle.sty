% University of Dayton color scheme
\definecolor{FlyersBlue}{HTML}{003087}
\definecolor{FlyersRed}{HTML}{CE0037}
\definecolor{FlyersRedDamp}{HTML}{CE1141}

% tcolorbox style controls (color/linewidth/background/linestyle)
\makeatletter
\newcommand{\tcblinecolor}{FlyersBlue}
\newcommand{\tcblinethickness}{1.5pt}
\tcbset{
  color/.code={%
    \renewcommand{\tcblinecolor}{#1}%
    \tcbset{colframe=#1, coltitle=#1}%
  },
  linewidth/.code={%
    \renewcommand{\tcblinethickness}{#1}%
    \tcbset{boxrule=#1}%
  },
  background/.style={colback=#1},
  linestyle/.code={%
    \def\temp{#1}\def\dash{dashed}%
    \ifx\temp\dash
      \tcbset{frame empty, borderline={\tcblinethickness}{0pt}{\tcblinecolor, dashed}}%
    \else
      \tcbset{frame engine=standard, colframe=\tcblinecolor, boxrule=\tcblinethickness, borderline={0pt}{0pt}{\tcblinecolor}}%
    \fi
  }
}
\makeatother

\NewDocumentEnvironment{tcb}{ O{} m }{%
  \begin{tcolorbox}[
    enhanced,
    arc=3mm,
    boxrule=0.6pt,
    colframe=\tcblinecolor,
    colback=white,
    width=\linewidth,
    fonttitle=\bfseries,
    coltitle=\tcblinecolor,
    colbacktitle=\tcblinecolor!10,
    boxed title style={colframe=\tcblinecolor, colback=\tcblinecolor!10, boxrule=0.6pt},
    attach boxed title to top center={yshift=-2mm},
    title={#2},
    before skip=2mm,
    after skip=2mm,
    #1
  ]
}{%
  \end{tcolorbox}
}

% Custom bibliography/footcite logic
\renewbibmacro*{title}{%
  \ifboolexpr{test {\iffieldundef{title}}}
  {}
  {%
    \iffieldundef{url}
      {\textcolor{FlyersBlue}{\printfield[titlecase]{title}}}%
      {\href{\thefield{url}}{\textcolor{FlyersBlue}{\printfield[titlecase]{title}}}}%
  }%
}
\renewbibmacro*{urldate}{}
\AtEveryBibitem{\clearfield{doi}}
\DeclareFieldFormat{url}{%
  \ifboolexpr{ test{\ifentrytype{misc}} or test{\ifentrytype{online}} }{%
    \mkbibacro{URL}\addcolon\space\url{#1}%
  }{}%
}
% Keep citation back-reference page numbers in FlyersRed
% (biblatex backrefs are a list; style both field and list rendering)
\DeclareFieldFormat{pageref}{\textcolor{FlyersRed}{#1}}
\DeclareListFormat{pageref}{\textcolor{FlyersRed}{#1}}


% Bibliography heading style (left-aligned red title)
\defbibheading{subbibliography}[1]{%
  \par\vspace{1.1\baselineskip}\noindent\hspace*{-2.0\bibhang}\textcolor{FlyersRed}{\large\sffamily\bfseries #1}\par\nobreak\vspace{0.05\baselineskip}%
}

% Chapter include helper with per-chapter bibliography
\let\latexchapter\chapter
\newcommand{\chaptertitle}[1]{\latexchapter{#1}}
\newcommand{\bookchapter}[1]{%
  \begin{refsection}%
    \input{#1}%
    \printbibliography[heading=subbibliography,title={Bibliography}]%
  \end{refsection}%
}

