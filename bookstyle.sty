%----------------------------------------------------------------------------------------
%	SECTION NUMBERING IN THE MARGIN
%----------------------------------------------------------------------------------------

\makeatletter

% 1. Custom Numbering Color (Margin Numbers)
% Section = Red, Subsection & Subsubsection = Blue
\renewcommand{\@seccntformat}[1]{%
  \llap{%
    \ifstrequal{#1}{section}%
      {\textcolor{FlyersRed}{\csname the#1\endcsname}}%
      {\textcolor{FlyersBlue}{\csname the#1\endcsname}}%
    \hspace{1em}%
  }%
}

% 2. Section Title - Red Text
\renewcommand{\section}{\@startsection{section}{1}{\z@}
{-4ex \@plus -1ex \@minus -.4ex}
{1ex \@plus.2ex }
{\normalfont\large\sffamily\bfseries\color{FlyersRed}}}

% 3. Subsection Title - Blue Text
\renewcommand{\subsection}{\@startsection {subsection}{2}{\z@}
{-3ex \@plus -0.1ex \@minus -.4ex}
{1.5ex \@plus.2ex }
{\normalfont\sffamily\bfseries\color{FlyersBlue}}}

% 4. Subsubsection Title - Blue Text
\renewcommand{\subsubsection}{\@startsection {subsubsection}{3}{\z@}
{-2ex \@plus -0.1ex \@minus -.2ex}
{.2ex \@plus.2ex }
{\normalfont\small\sffamily\bfseries\color{FlyersBlue}}}

% 5. Paragraph (Neutral)
\renewcommand\paragraph{\@startsection{paragraph}{4}{\z@}
{-2ex \@plus-.2ex \@minus .2ex}
{.1ex}
{\normalfont\small\sffamily\bfseries}}


