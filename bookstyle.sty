{}
{\sffamily\color{FlyersRed}\;\titlerule*[.5pc]{.}\;\thecontentspage} % Page number
[]

% Subsection text styling
\titlecontents{subsection}[1.75cm] % Indentation
{\addvspace{1pt}\sffamily\small\color{FlyersBlue}} % Spacing and font options for subsections
{\color{FlyersBlue}\contentslabel[\thecontentslabel]{1.0cm}} % Subsection number
{}
{\sffamily\color{FlyersBlue}\;\titlerule*[.5pc]{.}\;\thecontentspage} % Page number
[] 

